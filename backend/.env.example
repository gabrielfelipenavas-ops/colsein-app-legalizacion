PORT=3001
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=colsein_gastos
DB_USER=postgres
DB_PASS=postgres

# JWT — OBLIGATORIO: en producción el servidor NO arranca si esta clave está
# vacía o usa el valor por defecto. Genera una cadena larga y aleatoria, p. ej.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria
JWT_EXPIRES_IN=7d

# Anthropic (Claude Vision API for OCR)
ANTHROPIC_API_KEY=

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=26214400

# Colsein defaults
COLSEIN_NIT=800002030
COLSEIN_NOMBRE=COLSEIN S.A.S.
TARIFA_CARRO=600.65
TARIFA_MOTO=507.03

# Email notifications (opcional)
# Si SMTP_HOST está vacío, sólo se envían notificaciones in-app.
# Para Gmail usa una "App Password" (https://myaccount.google.com/apppasswords)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="COLSEIN Legalizaciones <no-reply@colsein.co>"
APP_URL=http://localhost:5173

# Recorrido GPS / cálculo de kilómetros (opcional)
# ORS_API_KEY: llave GRATUITA de OpenRouteService (openrouteservice.org) para
# calcular km por carretera real. Si se deja vacía, se usa el cálculo interno
# (línea recta × ROAD_FACTOR), que es gratis y siempre funciona.
ORS_API_KEY=
ROAD_FACTOR=1.3
